# SaarnaVideo environment
#
# Development defaults to SQLite. For production, use PostgreSQL instead.
# Never commit a real .env file or OAuth secrets.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/saarnavideo"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Media / rendering
# -----------------------------------------------------------------------------
MEDIA_ROOT="./data/media"
# The containerized worker supplies FFmpeg and yt-dlp; the host does not need them.
MAX_SOURCE_SIZE_BYTES="53687091200"
MAX_OUTPUT_SIZE_BYTES="107374182400"
MAX_DURATION_SECONDS="43200"
MAX_UPLOAD_BYTES="53687091200"
MAX_CONCURRENT_JOBS="2"
REQUEST_TIMEOUT_SECONDS="3600"
WORKER_POLL_MS="750"

# -----------------------------------------------------------------------------
# YouTube OAuth / integration
# -----------------------------------------------------------------------------
# Required for connecting a YouTube account and publishing.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/integrations/youtube/callback"
# Generate with: openssl rand -hex 32
# Keep this secret and stable; changing it invalidates stored OAuth tokens.
YOUTUBE_TOKEN_ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Transcription
# -----------------------------------------------------------------------------
PYTHON_PATH="python"
TRANSCRIPTION_MODEL="small"
TRANSCRIPTION_DEVICE="cpu"

# -----------------------------------------------------------------------------
# Optional security / deployment settings
# -----------------------------------------------------------------------------
INTERNAL_API_SECRET=""
