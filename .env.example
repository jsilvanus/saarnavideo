# SaarnaVideo environment
#
# Development defaults to SQLite. For production, use PostgreSQL instead.
# Never commit a real .env file or OAuth secrets.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default development database:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example (use this instead in production):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/saarnavideo"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Media / rendering
# -----------------------------------------------------------------------------
# Local directory used for uploaded sources and generated media.
MEDIA_ROOT="./data/media"

# FFmpeg and yt-dlp are expected to be available on PATH.
# Override these only if they are installed elsewhere.
# FFMPEG_PATH="ffmpeg"
# YTDLP_PATH="yt-dlp"

MAX_SOURCE_SIZE_BYTES="53687091200"
MAX_OUTPUT_SIZE_BYTES="107374182400"
MAX_DURATION_SECONDS="43200"
MAX_UPLOAD_BYTES="53687091200"
MAX_CONCURRENT_JOBS="2"
REQUEST_TIMEOUT_SECONDS="3600"
WORKER_POLL_MS="3000"

# Projects are persistent. Media is not automatically deleted by age.
# Set these only if an explicit media-cleanup policy is later enabled.
# MEDIA_RETENTION_DAYS=""

# -----------------------------------------------------------------------------
# YouTube OAuth / integration
# -----------------------------------------------------------------------------
# Required for YouTube OAuth and publishing. Not required for local upload-only use.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# OAuth callback used during local development:
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/integrations/youtube/callback"

# -----------------------------------------------------------------------------
# Transcription
# -----------------------------------------------------------------------------
# The transcription worker uses Python/faster-whisper when enabled.
PYTHON_PATH="python"
TRANSCRIPTION_MODEL="small"
TRANSCRIPTION_DEVICE="cpu"

# -----------------------------------------------------------------------------
# Optional security / deployment settings
# -----------------------------------------------------------------------------
# Set a long random value when the application exposes protected internal APIs.
# INTERNAL_API_SECRET=""
