# SaarnaVideo environment
#
# Development defaults to SQLite. For production, use PostgreSQL instead.
# Never commit a real .env file or OAuth secrets.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/saarnavideo"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Shared-secret login for the whole app (pages and /api). Unset = no gate. Generate: openssl rand -base64 32
# ACCESS_SECRET=""
# Production note: direct uploads return 503 unless ACCESS_SECRET is set. The app has no other built-in auth.

# -----------------------------------------------------------------------------
# Media / rendering
# -----------------------------------------------------------------------------
MEDIA_ROOT="./data/media"
# Where media files (uploads, outputs, asset library) live. Chosen at install time:
#   local (default): files under MEDIA_ROOT, app and worker share that volume.
#   s3: files in an S3-compatible bucket; MEDIA_ROOT is only worker scratch space. Startup fails if the bucket or
#       credentials are missing (no silent fallback to local disk).
# Existing local rows keep working after switching to s3; move them with `npm run media:migrate -- --to s3`.
# MEDIA_STORAGE="local"
# MEDIA_S3_BUCKET="saarnavideo-media"
# MEDIA_S3_PREFIX="media"
# MEDIA_S3_ENDPOINT="https://hel1.your-objectstorage.com"   # S3-compatible stores only
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# MEDIA_CACHE_MAX_BYTES="21474836480"   # worker download cache for S3 files (default 20 GB)
# The containerized worker supplies FFmpeg and yt-dlp; the host does not need them.
MAX_SOURCE_SIZE_BYTES="53687091200"
MAX_OUTPUT_SIZE_BYTES="107374182400"
MAX_DURATION_SECONDS="43200"
MAX_UPLOAD_BYTES="53687091200"
UPLOAD_STALE_AFTER_MS="86400000"              # pending direct upload sessions older than this are aborted/removed (default 24 h)
# Jobs the worker runs side by side. Default 1, or 4 when RENDER_EXECUTOR=fffleet. Publications always run in their own lane.
MAX_CONCURRENT_JOBS="2"
REQUEST_TIMEOUT_SECONDS="3600"
WORKER_POLL_MS="750"

# Optional: render on an fffleet fleet (https://github.com/jsilvanus/fffleet) instead of this machine.
# Files travel through S3 (the worker uploads what a render reads and downloads the result), so remote
# workers need no shared volume. Without FFFLEET_URL the render still runs here, through the same S3 staging.
# RENDER_EXECUTOR="fffleet"
# FFFLEET_URL="http://orchestrator:5000"
# FFFLEET_CLIENT_ID=""        # an app login (fffleet-orchestrator add-client), or use FFFLEET_TOKEN
# FFFLEET_CLIENT_SECRET=""
# FFFLEET_S3_BUCKET="saarnavideo-render"
# FFFLEET_S3_PREFIX="saarnavideo"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# FFFLEET_S3_ENDPOINT=""      # for S3-compatible stores such as Hetzner Object Storage or MinIO
# FFFLEET_CACHE_DIR=""        # local fallback only: keep staged inputs between jobs

# Optional: run the yt-dlp DOWNLOAD job on an fffleet worker too (same FFFLEET_* / AWS_* settings as above).
# The worker needs the "download" executor: build it with Dockerfile.fleet-worker. Default: local (yt-dlp runs in the worker).
# DOWNLOAD_EXECUTOR="fffleet"
# YTDLP_COOKIES_FILE=""       # Fallback Netscape cookie file on this host, used only when no cookies are stored in Settings
#                             # (Settings > YouTube cookies stores them encrypted with YOUTUBE_TOKEN_ENCRYPTION_KEY). Used by
#                             # the local and the fleet download path; a copy is staged for each remote job and the file is
#                             # updated if yt-dlp refreshed it.

# -----------------------------------------------------------------------------
# YouTube OAuth / integration
# -----------------------------------------------------------------------------
# Required for connecting a YouTube account and publishing.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/integrations/youtube/callback"
# Generate with: openssl rand -hex 32
# Keep this secret and stable; changing it invalidates stored OAuth tokens.
YOUTUBE_TOKEN_ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Facebook Page publishing (one Page, configured here; see docs/FACEBOOK_SETUP.md)
# -----------------------------------------------------------------------------
# Both must be set on the web app (status endpoint, publish route) and on the worker (upload).
# The Page access token is only read from the environment: it is never stored in the database or logged.
FACEBOOK_PAGE_ID=""
# Long-lived Page access token. Treat it like a password.
FACEBOOK_PAGE_ACCESS_TOKEN=""
# Optional. Graph API version used in every request.
FACEBOOK_GRAPH_VERSION="v24.0"
# Optional, for tests or a proxy: replaces https://graph.facebook.com (and graph-video.facebook.com).
# FACEBOOK_GRAPH_BASE_URL=""
# Optional worker tuning: seconds between processing-status checks (ms) and how long to wait for Facebook to process the video (ms).
# FACEBOOK_STATUS_POLL_MS="5000"
# FACEBOOK_PROCESSING_TIMEOUT_MS="1800000"

# -----------------------------------------------------------------------------
# Transcription
# -----------------------------------------------------------------------------
PYTHON_PATH="python"
TRANSCRIPTION_MODEL="small"
TRANSCRIPTION_DEVICE="cpu"

# Remote transcription via a liturgos-auditor-stt instance's batch jobs API
# (src/integrations/auditorStt), used by the worker's TRANSCRIBE job (see
# src/worker/index.ts) and the Transcription tab's UI. Point this at a
# running liturgos-auditor instance for the worker to actually complete jobs.
AUDITOR_STT_URL="http://localhost:8090"
# Only needed if that service has AUDITOR_STT_API_KEY set; sent as "Authorization: Bearer <key>".
AUDITOR_STT_API_KEY=""
# "upload" (default) streams the audio/video file to the service. "s3" stages 16 kHz mono audio in S3 for the job
# (FFFLEET_S3_BUCKET, AWS_*, FFFLEET_S3_ENDPOINT as for render staging) and gives the service a presigned URL
# (source_url); the service must list the bucket host in its AUDITOR_STT_SOURCE_URL_HOSTS.
# AUDITOR_STT_FETCH="upload"
#   "s3": stage extracted audio in S3 and send the service a URL. "s3-source": stage the original video and let the service strip the audio
#   on a fleet worker (needs AUDITOR_STT_STRIP=fleet there); partial ranges still use "s3". Both use FFFLEET_S3_*.
# docker compose runs the ghcr.io/jsilvanus/liturgos-auditor-stt image as the "auditor-stt" service
# (port 8090) and points the worker at http://auditor-stt:8090. AUDITOR_STT_URL above is for a worker
# running on the host. Whisper model the service loads (downloaded on first start): tiny, base, small, ...
AUDITOR_STT_MODEL="base"
# End-to-end transcription test (npm run test:e2e:transcription): set AUDITOR_STT_URL to a running
# service; the test skips itself when it is unset or /health fails. It needs espeak-ng to synthesize speech.

# -----------------------------------------------------------------------------
# Optional deployment settings
# -----------------------------------------------------------------------------
# Test-only overrides: point the YouTube integration at a fake server (e2e/fake-youtube-server.ts).
# Leave unset in production; the defaults are Google's endpoints.
# YOUTUBE_API_BASE_URL="https://www.googleapis.com"
# YOUTUBE_OAUTH_TOKEN_URL="https://oauth2.googleapis.com/token"

# API connectors (Asetukset page). Private and loopback addresses are blocked unless allowed here.
# Comma-separated hosts or CIDR-like entries as understood by varfetch; deny wins over allow.
# CONNECTOR_ALLOW="anno.internal.example"
# CONNECTOR_DENY=""
