FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install

FROM node:22-bookworm-slim AS worker
WORKDIR /app
ENV NODE_ENV=production

# The worker is the complete media-processing environment. The host does not
# need FFmpeg, ffprobe, yt-dlp, Python, or any other media tooling installed.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip \
  && python3 -m pip install --break-system-packages yt-dlp \
  && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* tsconfig.json next-env.d.ts prisma ./
COPY src ./src

# Fail the image build if the required media toolchain is unavailable.
# ffprobe is shipped with the FFmpeg Debian package and is used for media inspection.
RUN npx prisma generate \
  && ffmpeg -version \
  && ffprobe -version \
  && yt-dlp --version \
  && ffmpeg -hide_banner -loglevel error \
       -f lavfi -i color=c=black:s=16x16:d=0.1 \
       -f null -

CMD ["npm", "run", "worker"]
