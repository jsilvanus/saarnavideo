generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  UPLOAD
  YOUTUBE
}

enum OutputType {
  VIDEO
  THUMBNAIL
}

enum JobStatus {
  QUEUED
  ACQUIRING_SOURCE
  PROCESSING
  RENDERING
  COMPLETED
  FAILED
  EXPIRED
}

enum PublicationProvider {
  YOUTUBE
}

enum PublicationStatus {
  QUEUED
  UPLOADING
  COMPLETED
  FAILED
}

enum PrivacyState {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Project {
  id String @id @default(cuid())
  title String
  preacher String?
  gospelRef String?
  gospelText String?
  templateKey String @default("sermon")
  definition Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?
  source Source?
  jobs GenerationJob[]
  outputs Output[]
  publications Publication[]
}
model Source {
  id String @id @default(cuid())
  projectId String @unique
  type SourceType
  youtubeVideoId String?
  youtubeUrl String?
  originalName String?
  storagePath String?
  mimeType String?
  sizeBytes BigInt?
  durationMs Int?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
model GenerationJob {
  id String @id @default(cuid())
  projectId String
  status JobStatus @default(QUEUED)
  progress Int @default(0)
  error String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  completedAt DateTime?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}
model Output {
  id String @id @default(cuid())
  projectId String
  jobId String?
  type OutputType
  storagePath String
  mimeType String
  sizeBytes BigInt?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publications Publication[]
  @@index([projectId, createdAt])
}
model Publication {
  id String @id @default(cuid())
  projectId String
  outputId String?
  provider PublicationProvider
  externalId String?
  status PublicationStatus @default(QUEUED)
  privacy PrivacyState @default(PRIVATE)
  error String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  output Output? @relation(fields: [outputId], references: [id], onDelete: SetNull)
  @@index([projectId, createdAt])
}
model YouTubeConnection {
  id String @id @default(cuid())
  provider String @unique @default("youtube")
  accessToken String
  refreshToken String
  tokenExpiry DateTime?
  scope String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
